#!/bin/sh
# postinst of ff802-ucm-profile: bind the connected Fireface 802, if any.
# Never fails because of a missing or ambiguous device. Does not restart
# PipeWire or WirePlumber: the profile becomes active when the Fireface is
# reconnected (see README.Debian, volume safety).
set -e

case "$1" in
    configure)
        "${DPKG_ROOT:-}/usr/sbin/ff802-ucm-bind" auto || \
            echo "ff802-ucm-profile: binding failed; run 'sudo ff802-ucm-bind bind' later" >&2
        echo "ff802-ucm-profile: status: sudo ff802-ucm-bind status;" \
             "see /usr/share/doc/ff802-ucm-profile/README.Debian"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

exit 0
