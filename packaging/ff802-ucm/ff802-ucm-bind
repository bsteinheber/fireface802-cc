#!/bin/sh
# ff802-ucm-bind - device binding of the Fireface 802 UCM profile
# (package ff802-ucm-profile, variant A1 of docs/audio_ucm_einbindung.md).
#
# alsa-lib before 1.2.16 never loads USB-Audio/conf.d/<vid>-<pid>.conf
# (optional include bug, fixed upstream in commit 62c24074). ucm.conf
# however probes conf.d/USB-Audio/${CardLongName}.conf before
# USB-Audio.conf, and that lookup works. 'bind' creates exactly this file
# for the connected card, as a relative symbolic link to the master file
# shipped by the package. It never overwrites a file it did not create.
#
#   status        show cards, bindings and whether the workaround is needed
#   bind [--force]  bind the connected original Fireface 802
#   auto          like bind, but never fails (used by the postinst)
#   udev <N>      bind ALSA card N if it is an original Fireface 802 in CC
#                 mode; run by 77-ff802-ucm-bind.rules, never fails (0.3.0)
#   unbind        remove every binding created by this tool
#
# 'udev' makes the profile work on every USB port: the long name contains
# the port, so each new port needs its own binding. The udev rule runs it
# on the "change" event of the sound card, which udev normally relays to
# PipeWire only after RUN programs have finished; it is short (no
# waiting), idempotent and only ever adds a binding. It does nothing with
# alsa-lib >= 1.2.16, never touches WirePlumber or any user state.
#
# Environment (tests and dpkg):
#   DPKG_ROOT                     root of the installation (set by dpkg)
#   FF802_UCM_PROC_ASOUND         ALSA procfs (default /proc/asound)
#   FF802_UCM_ALSA_LIB_VERSION    alsa-lib version (default: from dpkg)

set -eu

PROG=ff802-ucm-bind
VERSION=@VERSION@
ROOT=${DPKG_ROOT:-}
PROC=${FF802_UCM_PROC_ASOUND:-/proc/asound}
USBID="0424:3fdd"
UCM2=$ROOT/usr/share/alsa/ucm2
CONFD=$UCM2/conf.d/USB-Audio
# Link target, relative to $CONFD (usr/share/alsa/ucm2/conf.d/USB-Audio).
TARGET=../../../../ff802-ucm/longname-master.conf
MASTER=$ROOT/usr/share/ff802-ucm/longname-master.conf
STATE=$ROOT/var/lib/ff802-ucm
BINDINGS=$STATE/bindings

die() { echo "$PROG: error: $*" >&2; exit "${2:-2}"; }
info() { echo "$PROG: $*"; }

usage() {
    cat <<EOF
Usage: $PROG status | bind [--force] | auto | unbind | --help | --version
       $PROG udev <card number>   (internal: run by the udev rule)

Binds the Fireface 802 UCM profile to the connected card (alsa-lib < 1.2.16).
Since 0.3.0 the udev rule binds the card automatically whenever it is
connected, also on a new USB port. After a manual bind or unbind,
reconnect the Fireface (or restart WirePlumber) for PipeWire to pick up
the change.
EOF
}

alsa_lib_version() {
    if [ -n "${FF802_UCM_ALSA_LIB_VERSION:-}" ]; then
        echo "$FF802_UCM_ALSA_LIB_VERSION"
        return
    fi
    if [ -n "$ROOT" ]; then
        dpkg-query --admindir="$ROOT/var/lib/dpkg" -W -f='${Version}' libasound2t64 2>/dev/null || true
    else
        dpkg-query -W -f='${Version}' libasound2t64 2>/dev/null || true
    fi
}

# 0 if the long-name binding is needed (alsa-lib < 1.2.16 or unknown).
workaround_needed() {
    v=$(alsa_lib_version)
    [ -n "$v" ] || return 0
    dpkg --compare-versions "$v" lt 1.2.16
}

# Print "index<TAB>id<TAB>long name" for every card with USB id 0424:3fdd.
fireface_cards() {
    for d in "$PROC"/card[0-9]*; do
        [ -f "$d/usbid" ] || continue
        [ "$(cat "$d/usbid")" = "$USBID" ] || continue
        n=${d##*/card}
        id=$(cat "$d/id" 2>/dev/null || true)
        ln=$(sed -n "/^ *$n \[/{n;s/^ *//;s/ *\$//;p;q;}" "$PROC/cards" 2>/dev/null || true)
        printf '%s\t%s\t%s\n' "$n" "$id" "$ln"
    done
}

is_original() {
    case $1 in
        *"802 FS"*) return 1 ;;
        *"Fireface 802"*) return 0 ;;
        *) return 1 ;;
    esac
}

# A long name is used as a file name: refuse anything unusual.
name_ok() {
    case $1 in
        ""|*/*|.*) return 1 ;;
    esac
    [ "$(printf '%s' "$1" | wc -l)" -eq 0 ] || return 1
    [ "${#1}" -le 200 ] || return 1
    return 0
}

ours() {
    [ -L "$1" ] && [ "$(readlink "$1")" = "$TARGET" ]
}

record() {
    mkdir -p "$STATE"
    touch "$BINDINGS"
    grep -qxF -- "$1" "$BINDINGS" || printf '%s\n' "$1" >> "$BINDINGS"
}

# Long name of an original Fireface 802 at high speed, exactly as
# snd-usb-audio builds it: "RME Fireface 802 (<serial>) at usb-<host
# controller>-<port path>, high speed". Rejects the 802 FS ("802 FS"),
# every other device and anything that is unsafe as a file name.
strict_name_ok() {
    name_ok "$1" || return 1
    printf '%s\n' "$1" | grep -Eqx \
        'RME Fireface 802 \([0-9]{1,16}\) at usb-[0-9A-Za-z:._-]{1,64}-[1-9][0-9]{0,2}(\.[1-9][0-9]{0,2}){0,6}, high speed'
}

# udev <N>: bind ALSA card N. Exits 0 in every case; each decision is
# logged (stdout and syslog). Only ever adds a binding: a file that exists
# under the card's name is never replaced, nothing is removed.
cmd_udev() {
    n=$1
    ulog() {
        echo "$PROG: udev card$n: $*"
        if command -v logger > /dev/null 2>&1; then
            logger -t "$PROG" -- "udev card$n: $*" 2>/dev/null || true
        fi
    }
    case $n in
        ""|*[!0-9]*|0?*) ulog "invalid card number; nothing done"; return 0 ;;
    esac
    [ "$n" -le 31 ] || { ulog "invalid card number; nothing done"; return 0; }
    d=$PROC/card$n
    usbid=$(cat "$d/usbid" 2>/dev/null || true)
    [ "$usbid" = "$USBID" ] || { ulog "USB id '$usbid' is not $USBID; nothing done"; return 0; }
    ln=$(sed -n "/^ *$n \[/{n;s/^ *//;s/ *\$//;p;q;}" "$PROC/cards" 2>/dev/null || true)
    if ! strict_name_ok "$ln"; then
        ulog "'$ln' is not an original Fireface 802 at high speed; nothing done"
        return 0
    fi
    if ! workaround_needed; then
        ulog "alsa-lib $(alsa_lib_version) loads USB-Audio/conf.d itself; no binding created"
        return 0
    fi
    [ -f "$MASTER" ] || { ulog "master file missing; nothing done"; return 0; }
    [ -d "$CONFD" ] && [ -w "$CONFD" ] || { ulog "$CONFD missing or not writable; nothing done"; return 0; }

    # serialise simultaneous events (best effort, never blocks for long)
    lockf=$ROOT/run/$PROG.lock
    if command -v flock > /dev/null 2>&1 && [ -d "${lockf%/*}" ] && [ -w "${lockf%/*}" ]; then
        exec 9>> "$lockf"
        flock -w 5 9 || ulog "lock busy; continuing"
    fi

    f=$CONFD/$ln.conf
    if ours "$f"; then
        (record "$ln") 2>/dev/null || ulog "warning: cannot record the binding in $BINDINGS"
        ulog "already bound: $ln"
        return 0
    fi
    if [ -e "$f" ] || [ -L "$f" ]; then
        ulog "$f exists and was not created by $PROG; left alone"
        return 0
    fi
    # record first: a link is never created without an entry for unbind/postrm
    if ! (record "$ln") 2>/dev/null; then
        ulog "cannot record the binding in $BINDINGS; nothing done"
        return 0
    fi
    if ln -s -- "$TARGET" "$f" 2>/dev/null; then
        ulog "bound: $ln"
    elif ours "$f"; then
        ulog "already bound: $ln"
    else
        ulog "could not create $f; nothing done"
    fi
    return 0
}

cmd_status() {
    echo "alsa-lib: $(alsa_lib_version || true)"
    if workaround_needed; then
        echo "workaround: needed (alsa-lib < 1.2.16 ignores USB-Audio/conf.d)"
    else
        echo "workaround: not needed (alsa-lib >= 1.2.16 loads USB-Audio/conf.d/0424-3fdd.conf)"
    fi
    cards=$(fireface_cards)
    if [ -z "$cards" ]; then
        echo "cards: no ALSA card with USB id $USBID"
    else
        printf '%s\n' "$cards" | while IFS="$(printf '\t')" read -r n id ln; do
            if ! is_original "$ln"; then
                s="not an original Fireface 802, ignored"
            elif ours "$CONFD/$ln.conf"; then
                s="bound"
            else
                s="NOT bound"
            fi
            echo "card $n ($id): $ln: $s"
        done
    fi
    if [ -s "$BINDINGS" ]; then
        echo "bindings:"
        while IFS= read -r ln; do
            if ours "$CONFD/$ln.conf"; then s=ok; else s=MISSING; fi
            echo "  $ln ($s)"
        done < "$BINDINGS"
    else
        echo "bindings: none"
    fi
}

cmd_bind() {
    force=$1 soft=$2
    fail() { if [ "$soft" = 1 ]; then info "$1"; exit 0; else die "$1" "${2:-2}"; fi; }

    [ -f "$MASTER" ] || fail "master file $MASTER missing (package not installed?)"
    [ -d "$CONFD" ] || fail "$CONFD missing (alsa-ucm-conf not installed?)"
    if ! workaround_needed && [ "$force" != 1 ]; then
        info "alsa-lib $(alsa_lib_version) loads USB-Audio/conf.d itself; no binding needed (use --force to bind anyway)"
        exit 0
    fi
    cards=$(fireface_cards)
    originals=$(printf '%s\n' "$cards" | while IFS="$(printf '\t')" read -r n id ln; do
        [ -n "$n" ] && is_original "$ln" && printf '%s\n' "$ln"
    done || true)
    count=$(printf '%s' "$originals" | grep -c . || true)
    [ "$count" -ge 1 ] || fail "no original Fireface 802 in CC mode found (USB id $USBID); connect it and run '$PROG bind'" 3
    [ "$count" -eq 1 ] || fail "$count original Fireface 802 cards found; refusing to guess"
    name=$originals
    name_ok "$name" || fail "card long name '$name' cannot be used as a file name"
    f=$CONFD/$name.conf
    if ours "$f"; then
        record "$name"
        info "already bound: $name"
        exit 0
    fi
    if [ -e "$f" ] || [ -L "$f" ]; then
        fail "$f exists and was not created by $PROG; not touching it" 4
    fi
    [ -w "$CONFD" ] || fail "cannot write $CONFD (run with sudo)"
    ln -s -- "$TARGET" "$f"
    record "$name"
    info "bound: $name"
    info "reconnect the Fireface 802 (or restart WirePlumber) to activate the profile"
}

cmd_unbind() {
    [ -s "$BINDINGS" ] || { info "no bindings"; rm -f -- "$BINDINGS"; return 0; }
    [ -w "$CONFD" ] || [ ! -d "$CONFD" ] || die "cannot write $CONFD (run with sudo)"
    while IFS= read -r ln; do
        f=$CONFD/$ln.conf
        if ours "$f"; then
            rm -f -- "$f"
            info "unbound: $ln"
        elif [ -e "$f" ] || [ -L "$f" ]; then
            info "left alone (not created by $PROG): $f"
        fi
    done < "$BINDINGS"
    rm -f -- "$BINDINGS"
    rmdir -- "$STATE" 2>/dev/null || true
}

case ${1:-} in
    status) cmd_status ;;
    bind)
        case ${2:-} in
            "") cmd_bind 0 0 ;;
            --force) cmd_bind 1 0 ;;
            *) usage >&2; exit 2 ;;
        esac ;;
    auto) cmd_bind 0 1 ;;
    udev)
        [ $# = 2 ] || { usage >&2; exit 2; }
        cmd_udev "$2"
        exit 0 ;;
    unbind) cmd_unbind ;;
    -h|--help) usage ;;
    --version) echo "$PROG $VERSION" ;;
    *) usage >&2; exit 2 ;;
esac
