
# ff802-cc-auto (T4): one USB connection of the Fireface 802 in
# class-compliant mode (0424:3fdd).
# Instance: <kernel name>:<busnum>:<devnum>, wanted by 70-ff802-cc-auto.rules.
# (Proprietary mode, 2a39:3fcd: ff802-cc-auto-enable@.service.)
#
# If a switch was prepared for this port (pending marker of
# ff802-cc-auto-enable@.service): the confirmation event "cc-active".
# After an automatic port reset this instance (new devnum) waits for the
# lock until the enable unit has finished; it never waits for that unit
# otherwise.
#
# Only if 'ff802-cc-auto mixer-init on' (off by default, independent of
# the automation): waits up to 15 s for the MIDI port "Port 2" of this
# connection and sets the 38 fixed mixer registers (configuration
# ff802-mixer-init-v3, checksum 0xEC858A44: Playback 1/2 -> Phones 9/10
# off, Playback 1..12 -> Output 1..12 and the volumes of Output 1..12 at
# 0 dB, Input 9 -> Output 1..12 at 30 %; entries 1..26 = v2, 0xC97A359C)
# through the ALSA sequencer, the whole list twice, 5 s apart. No USB
# access, no sysfs writes.
# Log: journalctl -t ff802-cc-auto

[Unit]
Description=Fireface 802: class-compliant mode for USB connection %i
Documentation=file:/usr/share/doc/ff802-cc-auto/README.Debian
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/ff802-cc/ff802-cc-autoswitch --service %i
# up to ~20 s waiting for the lock of a running port reset + 15 s for the
# MIDI port + sending
TimeoutStartSec=60
SyslogIdentifier=ff802-cc-auto
RuntimeDirectory=ff802-cc-auto
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022

# Root without any capability: enough for the ALSA sequencer
# (/dev/snd/seq) of the mixer initialisation; no USB device nodes,
# nothing else is writable.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-alsa rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
