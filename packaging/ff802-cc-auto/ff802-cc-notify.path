# ff802-cc-auto (T4), systemd user unit: watch the event files of the
# Fireface 802 automation (mode switch and mixer initialisation) and show
# new events in this session.
[Unit]
Description=Fireface 802: watch for mode switch notifications
Documentation=file:/usr/share/doc/ff802-cc-auto/README.Debian
PartOf=graphical-session.target

[Path]
PathChanged=/run/ff802-cc-auto/event
PathChanged=/run/ff802-cc-auto/mixer-event
Unit=ff802-cc-notify.service

[Install]
WantedBy=graphical-session.target
