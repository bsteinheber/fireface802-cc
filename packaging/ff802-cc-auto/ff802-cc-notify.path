# ff802-cc-auto (T4), systemd user unit: watch the event file of the
# Fireface 802 automation and show new events in this session.
[Unit]
Description=Fireface 802: watch for mode switch notifications
Documentation=file:/usr/share/doc/ff802-cc-auto/README.Debian
PartOf=graphical-session.target

[Path]
PathChanged=/run/ff802-cc-auto/event
Unit=ff802-cc-notify.service

[Install]
WantedBy=graphical-session.target
