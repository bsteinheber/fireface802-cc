#!/bin/sh
# postrm of ff802-cc-auto: on remove and purge the automation state is
# deleted, so a later installation always starts with the automation off.
set -e

case "$1" in
    remove|purge)
        rm -rf -- "${DPKG_ROOT:-}/var/lib/ff802-cc-auto" "${DPKG_ROOT:-}/run/ff802-cc-auto"
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            udevadm control --reload-rules || true
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac

exit 0
